# LLM provider: gemini, openai or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aircraft_mx

# Admin account - used ONLY by db/setup_db.py to create the schema, seed data
# and the read-only user. The Streamlit app never uses these.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Read-only account the app connects with (SELECT privilege only)
MYSQL_READONLY_USER=nl2sql_reader
MYSQL_READONLY_PASSWORD=change-me-reader-pass

# Guardrails
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_MS=15000

# Schema scope
# ALLOWED_TABLES: comma-separated tables the assistant may see. Empty = all tables in MYSQL_DATABASE.
#   e.g. ALLOWED_TABLES=aircraft,components,inspections
ALLOWED_TABLES=
# Above this many tables, the AI first picks the relevant tables, then writes SQL using only those.
SCHEMA_SELECTION_THRESHOLD=30
